{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -B -m pytest *)",
      "Bash(python .claude/scripts/verify.py *)",
      "Bash(python -B .claude/scripts/verify.py *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ]
  }
}
