{
  "name": "@arc/decision-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:audit": "svelte-check --tsconfig ./tsconfig.audit.json",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:workspace": "npm run build && cargo build --manifest-path ../../Cargo.toml -p arc -p arc-decision-ui-host --features arc-decision-ui-host/custom-protocol",
    "build:workspace:release": "npm run build && cargo build --manifest-path ../../Cargo.toml --release -p arc -p arc-decision-ui-host --features arc-decision-ui-host/custom-protocol",
    "preview": "vite preview",
    "test": "vitest run",
    "test:webdriver": "wdio run webdriver/wdio.conf.ts",
    "test:webdriver:types": "tsc --project webdriver/tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@wdio/cli": "9.31.4",
    "@wdio/globals": "9.31.3",
    "@wdio/junit-reporter": "9.31.2",
    "@wdio/local-runner": "9.31.4",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.5.1",
    "@wdio/types": "9.31.2",
    "jsdom": "30.0.1",
    "esbuild": "0.28.2",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.11",
    "webdriverio": "9.31.4"
  }
}
